# Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# LLM routing
LLM_PRIMARY_PROVIDER=ollama
LLM_FALLBACK_PROVIDER=gemini

# Local Ollama configuration
OLLAMA_MODEL=qwen2.5:3b

# Optional bearer token for API use. Without one, /api routes allow loopback clients only.
NEXORA_API_TOKEN=

# Comma-separated browser origins allowed to call the loopback API.
NEXORA_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
